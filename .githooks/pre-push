#!/usr/bin/env bash
# Refuses two pushes that caused most of our merge pain:
# - straight to main: changes reach main through a pull request (branch protection
#   refuses it on GitHub too; this says so before the upload);
# - a branch that is behind origin/main: merge main in first, so conflicts are solved
#   on your branch, by you, now, and CI tests what will actually land.
# Every agent and person gets this, since git runs it; Claude Code turns hooks on at
# session start (otherwise: git config core.hooksPath .githooks).

zero=0000000000000000000000000000000000000000
fetched=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # Tags (a release, the hackathon snapshot) point at old commits on purpose.
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: refusing to push to main. Push your branch and open a pull request (docs/agents/issue-tracker.md)." >&2
    exit 1
  fi
  if ! $fetched; then
    git fetch --quiet origin main || echo "pre-push: could not fetch origin/main; checking against the last one fetched." >&2
    fetched=true
  fi
  if ! git merge-base --is-ancestor origin/main "$local_sha" 2>/dev/null; then
    behind="$(git rev-list --count "$local_sha..origin/main" 2>/dev/null || echo "some")"
    echo "pre-push: ${remote_ref#refs/heads/} is $behind commits behind origin/main. Merge it in, rerun scripts/check.sh, then push:" >&2
    echo "  git merge origin/main" >&2
    exit 1
  fi
done
exit 0
