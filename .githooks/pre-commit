#!/usr/bin/env bash
# Secret scan on staged changes. Stack-agnostic, no installs.
# Enabled with `git config core.hooksPath .githooks` (Claude Code does it at session start).

fail=0

# 1. Env files, except the example.
while IFS= read -r f; do
  case "$f" in
    *.env.example|*.env.sample) ;;
    .env|*/.env|.env.*|*/.env.*)
      echo "pre-commit: refusing to commit env file: $f" >&2; fail=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. Key-shaped strings in added lines.
patterns=(
  'AKIA[0-9A-Z]{16}'                                   # AWS access key
  # Not inside a word, so slugs like "flood-risk-levels-..." pass.
  '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'              # OpenAI / Anthropic style
  '(^|[^A-Za-z0-9])sk-ant-[A-Za-z0-9_-]{20,}'
  'gh[pousr]_[A-Za-z0-9]{30,}'                         # GitHub tokens
  'github_pat_[A-Za-z0-9_]{30,}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'                       # Slack
  'AIza[0-9A-Za-z_-]{35}'                              # Google API key
  'sk_live_[0-9a-zA-Z]{20,}'                           # Stripe
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '(api[_-]?key|secret|token|password)["'"'"' ]*[:=] *["'"'"'][^"'"'"' ]{16,}["'"'"']'
)
added=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/pre-commit' | grep -E '^\+[^+]')
for p in "${patterns[@]}"; do
  hits=$(grep -inE -- "$p" <<<"$added")
  if [ -n "$hits" ]; then
    echo "pre-commit: possible secret (pattern: $p):" >&2
    echo "$hits" | cut -c1-120 >&2
    fail=1
  fi
done

if [ $fail -ne 0 ]; then
  echo >&2
  echo "Move secrets into .env (gitignored) and reference them from code. See AGENTS.md > Secrets." >&2
  exit 1
fi

# 3. Keep the ticket progress table in docs/tickets/README.md current.
if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^docs/tickets/[0-9][^/]*\.md$'; then
  scripts/ticket-status.sh --markdown > docs/tickets/README.md
  git add docs/tickets/README.md
fi
