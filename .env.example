# Copy to .env and fill in. One line per key, with a comment saying what it's for.
# Never commit .env. Never use these in frontend code.

# Node settings (read from the environment; no secrets yet)
# NODE_NAME=node-1      # name shown on the dashboard
# NODE_ROLE=sensor      # "sensor" or "hub"
# NODE_PORT=8000        # port the Node and its dashboard listen on
# NODE_LATITUDE=27.9731   # where this Node sits (default: Betrawati); only a ~200 m grid-snapped copy is shared; give each demo Node its own spot or their markers stack
# NODE_LONGITUDE=85.1860
# NODE_RIVER_KM=          # km down the river from the Lhende-Kyirong confluence (S0 is -12.2); blank means this Node cannot start a Community Warning
# NODE_MESH=reticulum   # "reticulum" (default) or "memory" (a Node that hears only itself)
# NODE_MESH_INTERFACE=auto   # "auto" finds Nodes on the local Wi-Fi; "loopback" joins Nodes on one machine (no Pis needed); "tcp" dials the addresses in NODE_TCP_PEERS (Tailscale)
# NODE_LOOPBACK_SLOT=0   # loopback only: a different number (0, 1, 2...) for each Node on this machine
# NODE_LOOPBACK_FIRST_SLOT=0   # loopback only: the lowest NODE_LOOPBACK_SLOT of this Node's group; it never dials Nodes below it
# NODE_TCP_PORT=4242   # tcp only: port this Node listens on for the other Nodes
# NODE_TCP_PEERS=   # tcp only: every other Node as host or host:port, comma-separated (Tailscale 100.x addresses work)
# NODE_INTERNET_CHECK_SECONDS=5   # how often this Node checks it has internet (and whether a camera picture is due); a few seconds is what the demo's cable pull is noticed within
# NODE_REPLAY_TRACK=   # which Sensor track of the replay this Node plays (S0 to S3, see node/src/storm_shield/replay_timeline.json); blank keeps the Scenario
# NODE_DATA_DIR=   # this Node's Reticulum config and identity (default node/data); never share between Nodes, never commit

# Map tiles: the Node fetches CARTO basemap tiles for the dashboard, and the Cache Pack build uses it too
# CARTO_API_KEY=        # from carto.com/basemaps/apikey; secret, so only ever set here, never in dashboard code

# Cache Pack (shelters, flood zones, map tiles); see scripts/cache-pack/README.md
# CACHE_PACK_URL=       # where to download cache-pack.zip: the GitHub Release (Hub) or http://<hub>:8000/api/cache-pack.zip (sensor)
# CACHE_PACK_DIR=       # where the Node keeps the downloaded pack (default: cache-pack/ in the repo)

# Shelter status (sent by the Hub over the mesh)
# HUB_IDENTITY=         # the Hub's Node id, printed in its startup log; a blank or wrong one means this Node ignores Shelter status and shows nothing open

# Forecast (the Hub fetches it from Open-Meteo, Sensors copy it from the Hub)
# NODE_WEATHER_FORECAST_URL=   # on a Sensor: the Hub's http://<hub>:8000/api/weather/forecast; blank means this Node never gets a forecast

# Pi Breadboard and hotspot; see pi/README.md
# NODE_GPIO=            # auto (default: on only on a Raspberry Pi), on (stop if the pins cannot start) or off
# HOTSPOT_SSID=         # name of the Wi-Fi the Pi hosts with pi/setup-hotspot.sh
# HOTSPOT_PASSWORD=     # its password, 8 or more characters; secret, only ever set here
