# Copy to .env and fill in. One line per key, with a comment saying what it's for.
# Never commit .env. Never use these in frontend code.

# Node settings (read from the environment; no secrets yet)
# NODE_NAME=node-1      # name shown on the dashboard
# NODE_ROLE=sensor      # "sensor" or "hub"
# NODE_PORT=8000        # port the Node and its dashboard listen on
