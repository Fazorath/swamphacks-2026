# Copy to .env and fill in. One line per key, with a comment saying what it's for.
# Never commit .env. Never use these in frontend code.

# Node settings (read from the environment; no secrets yet)
# NODE_NAME=node-1      # name shown on the dashboard
# NODE_ROLE=sensor      # "sensor" or "hub"
# NODE_PORT=8000        # port the Node and its dashboard listen on
# NODE_LATITUDE=29.6516   # where this Node sits; only a ~200 m grid-snapped copy is shared
# NODE_LONGITUDE=-82.3248

# Cache Pack (shelters, flood zones, map tiles); see scripts/cache-pack/README.md
# CACHE_PACK_URL=       # where to download cache-pack.zip: the GitHub Release (Hub) or http://<hub>:8000/api/cache-pack.zip (sensor)
# CACHE_PACK_DIR=       # where the Node keeps the downloaded pack (default: cache-pack/ in the repo)
